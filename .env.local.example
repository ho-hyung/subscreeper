# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Cron Job용 (선택)

# Exchange Rate API (https://exchangerate-api.com) - 선택사항
# 설정하지 않으면 무료 API (frankfurter.app) 사용
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Vercel Cron 인증 (선택)
CRON_SECRET=your-cron-secret

# Resend (이메일 발송) - https://resend.com
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=Subscreeper <onboarding@resend.dev>  # 또는 인증된 도메인

# App URL (이메일 내 링크용)
NEXT_PUBLIC_APP_URL=http://localhost:3600

# Web Push (VAPID Keys) - npx web-push generate-vapid-keys 로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
